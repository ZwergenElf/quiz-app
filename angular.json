{
  "version": 1,
  "projects": {
    "quiz-back": {
      "root": "apps/quiz-back",
      "sourceRoot": "apps/quiz-back/src",
      "projectType": "application",
      "targets": {
        "build": {
          "executor": "@nrwl/webpack:webpack",
          "outputs": ["{options.outputPath}"],
          "options": {
            "target": "node",
            "compiler": "tsc",
            "outputPath": "dist/apps/quiz-back",
            "main": "apps/quiz-back/src/main.ts",
            "tsConfig": "apps/quiz-back/tsconfig.app.json",
            "assets": ["apps/quiz-back/src/assets"],
            "webpackConfig": "apps/quiz-back/webpack.config.js"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "inspect": false
            }
          }
        },
        "serve": {
          "executor": "@nrwl/js:node",
          "options": {
            "buildTarget": "quiz-back:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "quiz-back:build:production"
            }
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "outputs": ["{options.outputFile}"],
          "options": {
            "lintFilePatterns": ["apps/quiz-back/**/*.ts"]
          }
        },
        "test": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
          "options": {
            "jestConfig": "apps/quiz-back/jest.config.ts",
            "passWithNoTests": true
          },
          "configurations": {
            "ci": {
              "ci": true,
              "codeCoverage": true
            }
          }
        }
      },
      "tags": []
    },
    "quiz-back-e2e": {
      "root": "apps/quiz-back-e2e",
      "implicitDependencies": ["quiz-back"],
      "targets": {
        "e2e": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
          "options": {
            "jestConfig": "apps/quiz-back-e2e/jest.config.ts",
            "passWithNoTests": true
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "outputs": ["{options.outputFile}"],
          "options": {
            "lintFilePatterns": ["apps/quiz-back-e2e/**/*.{js,ts}"]
          }
        }
      }
    },
    "quiz-front": "apps/quiz-front",
    "quiz-front-e2e": "apps/quiz-front-e2e",
    "quiz-front-lib-data-access": {
      "projectType": "library",
      "root": "libs/quiz-front-lib/data-access",
      "sourceRoot": "libs/quiz-front-lib/data-access/src",
      "prefix": "app",
      "targets": {
        "test": {
          "executor": "@nrwl/jest:jest",
          "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
          "options": {
            "jestConfig": "libs/quiz-front-lib/data-access/jest.config.ts",
            "passWithNoTests": true
          },
          "configurations": {
            "ci": {
              "ci": true,
              "codeCoverage": true
            }
          }
        },
        "lint": {
          "executor": "@nrwl/linter:eslint",
          "outputs": ["{options.outputFile}"],
          "options": {
            "lintFilePatterns": [
              "libs/quiz-front-lib/data-access/**/*.ts",
              "libs/quiz-front-lib/data-access/**/*.html"
            ]
          }
        }
      },
      "tags": ["scope:quiz-front", "type:data-access"]
    }
  }
}
