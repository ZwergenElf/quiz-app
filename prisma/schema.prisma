generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model QuizField {
  id       String  @id @default(cuid())
  question String
  answer   String
  colId    String
  rowId    String
  col      QuizCol @relation(fields: [colId], references: [id])
  row      QuizRow @relation(fields: [rowId], references: [id])
}

model QuizRow {
  id            String      @id @default(cuid())
  points        Int?
  tableId       String
  questionField QuizField[]
  table         QuizTable   @relation(fields: [tableId], references: [id])
}

model QuizCol {
  id            String      @id @default(cuid())
  category      String
  tableId       String
  table         QuizTable   @relation(fields: [tableId], references: [id])
  questionField QuizField[]
}

model QuizTable {
  id       String    @id @default(cuid())
  name     String
  tableCol QuizCol[]
  tableRow QuizRow[]
}

model User {
  username      String      @id @default(cuid())
  password      String
}