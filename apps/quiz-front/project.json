{
  "name": "quiz-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/quiz-front/src",
  "prefix": "app",
  "tags": [],
  "i18n": {
    "sourceLocale": "de-DE",
    "locales": {
      "en-GB": "apps/quiz-front/src/locale/messages.en-GB.xlf"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "i18nMissingTranslation": "warning",
        "localize": ["de-DE"],
        "outputPath": "dist/apps/quiz-front",
        "index": "apps/quiz-front/src/index.html",
        "main": "apps/quiz-front/src/main.ts",
        "polyfills": [
          "zone.js",
          "@angular/localize/init"
        ],
        "tsConfig": "apps/quiz-front/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/quiz-front/src/favicon.ico",
          "apps/quiz-front/src/assets"
        ],
        "styles": [
          "@angular/material/prebuilt-themes/deeppurple-amber.css",
          "apps/quiz-front/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "en-GB": {
          "localize": ["en-GB"]
        },
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "quiz-front:build:production"
        },
        "development": {
          "buildTarget": "quiz-front:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/quiz-front/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "quiz-front:build",
        "outputPath": "apps/quiz-front/src/locale"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/quiz-front/**/*.ts",
          "apps/quiz-front/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/quiz-front/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}